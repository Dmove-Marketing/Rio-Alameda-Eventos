---
// Gerado e refatorado para Dmove Clean-Room
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import '../styles/eventos-corporativos.css';
import '@fontsource/bebas-neue';
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/700.css';

import { getImage } from 'astro:assets';
import imgEquilibrioBg from '../assets/images/29988650_158-Convertido-scaled.webp';
import imgEquilibrioBox from '../assets/images/WhatsApp-Image-2025-01-14-at-11.28.10-scaled.jpeg';
import imgEstruturaBg from '../assets/images/grain-8-scaled.jpg';
import imgDividerBg from '../assets/images/WhatsApp-Image-2025-04-06-at-12.27.29-scaled.jpeg';
import imgContatoBg from '../assets/images/imgi_1_516514976_17885575200308417_3232230295027353569_n.jpg';
import fontBeyondInfinity from '../assets/fonts/Beyond-Infinity-Demo.woff';

const optEquilibrioBg = await getImage({ src: imgEquilibrioBg, format: 'webp', quality: 80, width: 1200 });
const optEquilibrioBox = await getImage({ src: imgEquilibrioBox, format: 'webp', quality: 80, width: 800 });
const optEstruturaBg = await getImage({ src: imgEstruturaBg, format: 'webp', quality: 75, width: 1000 });
const optDividerBg = await getImage({ src: imgDividerBg, format: 'webp', quality: 75, width: 1200 });
const optContatoBg = await getImage({ src: imgContatoBg, format: 'webp', quality: 80, width: 1200 });
---

<Base
  title="Eventos corporativos - Rio Alameda Eventos"
  description="O Rio Alameda é o espaço ideal para eventos corporativos na Zona Sul do Rio, com vista para o Cristo Redentor e estrutura de alto padrão."
  ogImage="https://eventos.rioalamedaeventos.com/images/og-image.jpg"
  canonical="https://eventos.rioalamedaeventos.com/"
  whatsAppStep1Fields={[
    { name: 'data', type: 'text', placeholder: 'Data do evento', required: true },
    { name: 'horario', type: 'text', placeholder: 'Horário do evento', required: true },
    { name: 'convidados', type: 'number', placeholder: 'N° de Pessoas (convidados)', required: true },
    { name: 'empresa', type: 'text', placeholder: 'Empresa', required: true },
    { name: 'tipo', type: 'select', placeholder: '', required: true, options: [
      { value: '', label: 'Tipo de evento' },
      { value: 'Confraternização corporativa', label: 'Confraternização corporativa' },
      { value: 'Corporativo', label: 'Corporativo' },
      { value: 'Feiras e Exposições', label: 'Feiras e Exposições' },
      { value: 'Masterclass e Palestras', label: 'Masterclass e Palestras' },
      { value: 'Mentorias e Treinamentos', label: 'Mentorias e Treinamentos' },
      { value: 'Offsite corporativo', label: 'Offsite corporativo' },
      { value: 'Reuniões de Networking', label: 'Reuniões de Networking' },
      { value: 'Workshops, Conferências e Seminários', label: 'Workshops, Conferências e Seminários' },
      { value: 'Outros', label: 'Outros' }
    ] }
  ]}
  whatsAppMessage="Olá, vamos conversar?\nEstamos ansiosos para saber mais sobre seu evento! 🎉"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://fast.wistia.net" />
    <link rel="preconnect" href="https://embed-cloudfront.wistia.com" crossorigin />
    <link rel="preload" href={fontBeyondInfinity} as="font" type="font/woff" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/koh5npl.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://use.typekit.net/koh5npl.css" /></noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mr+De+Haviland&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mr+De+Haviland&display=swap" /></noscript>
  </Fragment>

  <!-- Hero Section -->
  <section class="hero-section">
    <Img src="background-cristov3.webp" alt="" width={1920} height={1080} priority class="hero-bg-img" />
    <div class="video-background-wrapper">
      <iframe
        data-src="https://fast.wistia.net/embed/iframe/668z4mkvml?autoplay=true&muted=true&loop=true&controlsVisibleOnLoad=false&videoFoam=true&endVideoBehavior=loop&qualityMin=720"
        title="Vídeo de Fundo" allow="autoplay" frameborder="0" width="100%" height="100%">
      </iframe>
    </div>
    <div class="hero-container">
      <div class="logo-wrapper">
        <Img src="rio-alameda-sem-fundo-branca-e1758045596842.png" alt="Rio Alameda Logo" width={130} height={94} class="logo-img" priority />
      </div>
      <div class="hero-content">
        <h2 class="hero-title">Seu evento corporativo <br /> com vista para o</h2>
        <h1 class="hero-accent">Cristo Redentor</h1>
        <p class="hero-description">Um espaço sofisticado na Zona Sul do Rio, onde estrutura, localização e serviços de alto padrão se conectam para elevar a experiência do seu evento empresarial</p>
      </div>
      <div class="hero-actions">
        <a class="btn-primary" href="#contato">Solicite um orçamento</a>
      </div>
    </div>
  </section>

  <!-- Equilíbrio Section -->
  <section class="equilibrio-section" style={`background-image: url(${optEquilibrioBg.src});`}>
    <div class="equilibrio-container">
      <div class="equilibrio-box">
        <div class="equilibrio-content">
          <div class="section-title-wrapper">
            <h2 class="section-title">O perfeito equilíbrio entre</h2>
            <h3 class="section-subtitle">cidade<span class="accent-dot">,</span> natureza e neg<span class="accent-dot">ó</span>cios</h3>
          </div>
          <p class="section-text">Localizado estrategicamente na Zona Sul do Rio, o Rio Alameda Eventos conta com 1.000 m² de área, pé-direito alto e uma vista deslumbrante para o Cristo Redentor.<br />Aqui, sua empresa encontra a liberdade para personalizar cada detalhe e transformar encontros, convenções e celebrações corporativas em experiências marcantes.</p>
        </div>
        <div class="equilibrio-image" style={`background-image: url(${optEquilibrioBox.src});`}></div>
      </div>
    </div>
  </section>

  <!-- Estrutura Section -->
  <section class="estrutura-section" style={`background-image: url(${optEstruturaBg.src});`}>
    <div class="estrutura-container">
      <div class="estrutura-header">
        <h2 class="section-title dark-text">A estrutura completa para</h2>
