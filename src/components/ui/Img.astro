---
import { Image } from 'astro:assets';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  /** true = eager + fetchpriority high (use na imagem LCP/hero) */
  priority?: boolean;
  quality?: number;
  class?: string;
  style?: string;
  id?: string;
}

const {
  src,
  alt,
  width,
  height,
  priority = false,
  quality = 80,
  class: className,
  style,
  id,
} = Astro.props;

// Imagem remota (CDN) vira <img> direto, sem ser baixada no build:
// assim o build não quebra se algum arquivo estiver faltando no storage.
const isRemote = /^https?:\/\//.test(src);

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpg,jpeg,png,webp,avif,gif}',
  { eager: true }
);

const key = `/src/assets/images/${src}`;
const mod = isRemote ? null : images[key];

if (!isRemote && !mod) {
  console.warn(`[Img] imagem não encontrada: ${key}`);
}
---

{isRemote ? (
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : undefined}
    class={className}
    style={style}
    id={id}
  />
) : mod ? (
  <Image
    src={mod.default}
    alt={alt}
    width={width ?? 1200}
    height={height}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    quality={quality}
    class={className}
    style={style}
    id={id}
  />
) : (
  <img
    src=""
    alt={alt}
    width={width ?? 1200}
    height={height ?? undefined}
    class={className}
    style={style}
    id={id}
    data-placeholder={key}
    aria-hidden="true"
  />
)}
